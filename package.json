{
  "name": "cecafa-kagame-cup",
  "version": "1.0.0",
  "description": "CECAFA Kagame Cup 2026 — Rwanda. Tournament site for IGIHE.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000 --dns-result-order=ipv4first\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/index.ts",
    "start": "cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" next start"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/plugin-cloud-storage": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5",
    "@tanstack/react-table": "^8",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "payload": "3.86.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7",
    "recharts": "^2",
    "shadcn": "^4.16.1",
    "sharp": "0.34.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^3",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.7",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
