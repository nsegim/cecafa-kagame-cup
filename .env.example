NEW_DB_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
PAYLOAD_SECRET="YOUR_SECRET_HERE"

# --- Public site origin ------------------------------------------------------
# REQUIRED IN PRODUCTION. Used for canonical URLs, Open Graph tags, the sitemap
# and robots.txt. There is no way to detect the public origin at build time, so
# if this is left unset the site falls back to the placeholder in src/lib/site.ts
# and will hand search engines URLs pointing at the wrong host.
# No trailing slash.
NEXT_PUBLIC_SITE_URL="https://kagamecup.igihe.com"

# --- Cloudinary (media uploads) ---------------------------------------------
# Media uploads are stored in Cloudinary. Create an account, then copy the three
# values from the Cloudinary dashboard. Without all three, Payload falls back to
# local disk storage (fine for local dev, not for production).
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"
# Optional: the folder every upload is stored under (default "cecafa").
# CLOUDINARY_FOLDER="cecafa"

# --- Optional seed admin credentials ----------------------------------------
# SEED_ADMIN_EMAIL="support@igihe.rw"
# SEED_ADMIN_PASSWORD="ChangeMe!"
